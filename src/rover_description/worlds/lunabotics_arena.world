
<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arena">

    <!-- Physics settings -->
    <physics type="ode" name="default_physics">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ambient lighting -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.6 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sunlight -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Flat ground -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 6.88 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 6.88 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.55 0.38 1</ambient>
            <diffuse>0.65 0.55 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    
    <!-- North wall: positive Y -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 3.49 0.15 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>5.2 0.1 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.2 0.1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall: negative Y -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -3.49 0.15 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>5.2 0.1 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5.2 0.1 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall: positive X -->
    <model name="east_wall">
      <static>true</static>
      <pose>2.54 0 0.15 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6.88 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6.88 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall: negative X -->
    <model name="west_wall">
      <static>true</static>
      <pose>-2.54 0 0.15 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6.88 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6.88 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Test boulder -->
    <include>
      <uri>model://boulder</uri>
      <name>test_boulder</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>

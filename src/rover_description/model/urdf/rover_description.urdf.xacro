<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_description)/model/urdf/materials.urdf.xacro"/>
  <xacro:include filename="$(find rover_description)/model/urdf/wheel_link.urdf.xacro"/>

  <xacro:macro name="rover">

    <xacro:property name="PI" value="3.1415926535897931"/>
    <!-- Constants for robot dimensions -->
    <xacro:property name="base_mass" value="0.3" /> 
    <xacro:property name="base_width" value="0.32" />
    <xacro:property name="base_length" value="0.53" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="base_mast_height" value="0.3" />
    <xacro:property name="base_hinge_x_offset" value="${(base_length/2) - (base_length/5) - 0.06/2}" />
    <xacro:property name="base_hinge_z_offset" value="${(base_height) + 0.08 - 0.02}" />
    <!-- wheel constants -->
    <xacro:property name="wheel_mass" value="0.3" /> <!-- arbitrary value for wheel mass -->
    <xacro:property name="wheel_len" value="0.08" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_z_offset" value="${0.02-base_height/2}" /> 
    <xacro:property name="wheel_x_offset" value="${(base_length/2)-0.1}" /> 
    <xacro:property name="wheel_y_offset" value="${(base_width/2)+(wheel_len/2)+0.02}" /> 
    <!-- mast constants -->
    <xacro:property name="mast_y_offset" value="${base_width/2+0.02}"/>
    <xacro:property name="mast_z_offset" value="0.3"/>

    <!-- base_joint fixes base_link to the environment -->
    <joint name="base_joint" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- Base Link -->
    <link name="base_link">
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/base_link.stl" scale="1 1 1" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/base_link.stl" scale="1 1 1" />
        </geometry>
        <material name="orange"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
          ixx="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}" ixy="0.0" ixz="0.0"
          iyy="${base_mass / 12.0 * (base_height*base_height + base_width*base_width)}" iyz="0.0"
          izz="${base_mass / 12.0 * (base_width*base_width + base_length*base_length)}"/>
      </inertial>
    </link>

    <joint name="left_back_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_back_wheel"/>
      <origin xyz="${wheel_x_offset} -${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="1.0"/>
    </joint>

    <!-- left wheel Link -->
    <xacro:rover_wheel_link name="left_back_wheel" PI="${PI}" wheel_mass="${wheel_mass}" wheel_radius="${wheel_radius}" wheel_len="${wheel_len}"/>

    <joint name="right_back_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_back_wheel"/>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="1.0"/>
    </joint>

    <!-- right wheel Link -->
    <xacro:rover_wheel_link name="right_back_wheel" PI="${PI}" wheel_mass="${wheel_mass}" wheel_radius="${wheel_radius}" wheel_len="${wheel_len}"/>



    <joint name="left_front_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_front_wheel"/>
      <origin xyz="${-wheel_x_offset} ${-wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="1.0"/>
    </joint>

    <!-- left wheel Link -->
    <xacro:rover_wheel_link name="left_front_wheel" PI="${PI}" wheel_mass="${wheel_mass}" wheel_radius="${wheel_radius}" wheel_len="${wheel_len}"/>

    <joint name="right_front_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_front_wheel"/>
      <origin xyz="${-wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="1.0"/>
    </joint>

    <!-- right wheel Link -->
    <xacro:rover_wheel_link name="right_front_wheel" PI="${PI}" wheel_mass="${wheel_mass}" wheel_radius="${wheel_radius}" wheel_len="${wheel_len}"/>




    <joint name="boom_arm_to_base_link_joint" type="revolute">
      <parent link="base_link"/>
      <child link="boom_arm"/>
      <origin xyz="${base_hinge_x_offset} 0 ${base_hinge_z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit lower="0" upper="${PI/2}" effort="100" velocity="1.0"/>
    </joint>

    <link name="boom_arm">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/boom_arm.stl" scale="1 1 1" />
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/boom_arm.stl" scale="1 1 1" />
        </geometry>
        <material name="red"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
          ixx="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}" ixy="0.0" ixz="0.0"
          iyy="${base_mass / 12.0 * (base_height*base_height + base_width*base_width)}" iyz="0.0"
          izz="${base_mass / 12.0 * (base_width*base_width + base_length*base_length)}"/>
      </inertial> 
    </link>

    <joint name="gimbal_to_base_joint" type="continuous">
      <origin xyz="0 ${-mast_y_offset} ${mast_z_offset}" rpy="0.0 0.0 0.0"/>
      <parent link="base_link"/>
      <child link="gimbal_base"/>
      <axis xyz="0 0 1"/>
      <limit effort="0.0" velocity="0.0"/>
    </joint>

    <link name="gimbal_base">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/gimbal.stl" scale="1 1 1"/>
        </geometry>
        <material name="brown"/>
      </visual>

      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/gimbal.stl" scale="1 1 1"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
      </inertial>
    </link>

    <joint name="gimbal_to_gimbal_joint" type="revolute">
      <origin xyz="0 ${-0.02-0.01} ${0.01/2 + 0.05}" rpy="0.0 0.0 0.0"/>
      <parent link="gimbal_base"/>
      <child link="gimbal_y"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="${PI}" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="gimbal_y">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/gimbal.stl" scale="1 1 1"/>
        </geometry>
        <material name="brown"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/model/meshes/gimbal.stl" scale="1 1 1"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>